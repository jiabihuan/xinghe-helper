<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="60dp"
    android:paddingTop="24dp"
    android:paddingEnd="60dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="星河 PHP 服务"
        android:textColor="@color/home_text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="在电视盒子上启动本地 Web 服务，浏览器访问下方地址运行 PHP"
        android:textColor="@color/home_text_hint"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="访问地址"
            android:textColor="@color/home_text_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/phpUrlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="未启动"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/phpStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="点击下方按钮启动服务"
            android:textColor="@color/home_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/phpRootText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="PHP 文件目录："
            android:textColor="@color/home_text_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动后可在后台运行，退出页面不会停止。通过停止按钮或通知栏关闭。"
            android:textColor="@color/home_text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/phpToggleBtn"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="启动服务"
            android:textColor="@color/home_text_primary"
            android:textSize="16sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/selector_menu_item" />

        <TextView
            android:id="@+id/phpRestartBtn"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:text="重启服务"
            android:textColor="@color/home_text_primary"
            android:textSize="16sp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@drawable/selector_menu_item"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>